# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key — server-only, bypasses RLS. Used for privileged
# operations (account deletion, admin actions). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed to access /protected/admin.
ADMIN_EMAILS=you@example.com

# 32-byte key (base64) used to encrypt sensitive fields at rest.
# Generate with: openssl rand -base64 32
# Losing this key makes all encrypted data unrecoverable — back it up
# somewhere other than this file.
ENCRYPTION_KEY=
